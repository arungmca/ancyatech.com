# Shared secret between n8n and the worker
WORKER_TOKEN=replace-with-a-long-random-string
PORT=8788

# GitHub token: contents write + pull requests write on arungmca/ancyatech.com
GITHUB_TOKEN=github_pat_xxx
REPO=arungmca/ancyatech.com

# Agent provider: ollama (Aider + Ollama Cloud) or claude (Claude Code CLI)
AGENT_PROVIDER=ollama
OLLAMA_API_KEY=ollama_xxx
OLLAMA_BASE_URL=https://ollama.com/v1
OLLAMA_CHAT_URL=https://ollama.com/api/chat
OLLAMA_MODEL=qwen3-coder:480b

# Only needed when AGENT_PROVIDER=claude
ANTHROPIC_API_KEY=

# Checks run before commit. Comma separated.
CHECK_COMMANDS=npm ci,npm run build,npm run check,npm run check:a11y,npm run lint:html,npm run lint:js,npm test
