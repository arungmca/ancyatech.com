{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "web",
  "compatibility_date": "2026-10-23",
  "observability": {
    "enabled": true
  },
  "previews": {},
  // Give each Preview its own URL:
  //   https://<preview-name>-<worker>.<subdomain>.workers.dev
  // Alternative: add "previews_enabled": true to a custom_domain route to get
  //   https://<preview-name>.ancyatech.com
  "preview_urls": true,
  "assets": {
    "directory": "./public",
    // Serve extension-less URLs (/work) from work.html and show public/404.html for misses.
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  // Bind both hostnames to this Worker. Cloudflare creates the DNS records and
  // certificates on deploy; the hostnames must not have conflicting records.
  "routes": [
    { "pattern": "ancyatech.com", "custom_domain": true },
    { "pattern": "www.ancyatech.com", "custom_domain": true }
  ]
}
