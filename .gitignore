# Angular specific
/dist/
/out-tsc/
/tmp/
/coverage/
/e2e/test-output/
/.angular/
.angular/

# Node modules
node_modules/

# Note: lockfiles (package-lock.json, yarn.lock, pnpm-lock.yaml) must stay
# committed — CI installs with `npm ci` and needs a deterministic dependency
# tree. Do not re-add them here.

# Environment files (keep .env.example committed)
.env
.env.*
!.env.example

# Angular CLI and build artefacts
/.angular-cli.json
/.ng/

# TypeScript cache
*.tsbuildinfo

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Cloudflare Wrangler local state
.wrangler/

# GitHub Pages staging output (produced by the deploy workflow)
_site/

# OS / editor noise
.DS_Store
.idea/
.vscode/
